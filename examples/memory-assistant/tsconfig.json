{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@surrealdb/agent-memory-eve": ["../../dist/index.d.ts"],
      "@surrealdb/agent-memory-eve/tools": ["../../dist/tools/index.d.ts"]
    }
  },
  "include": ["agent/**/*.ts"]
}
