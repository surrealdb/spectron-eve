{
  "name": "@surrealdb/agent-memory-eve",
  "version": "0.2.0",
  "description": "Official Eve adapter for AgentMemory — persistent, provenance-tracked memory for Eve agents, backed by SurrealDB's AgentMemory memory layer.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surrealdb-dev/agentMemory-eve.git"
  },
  "keywords": [
    "agentMemory",
    "surrealdb",
    "eve",
    "agent",
    "memory",
    "ai"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test test/adapter.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@surrealdb/memory": "^1.0.0-alpha.9"
  },
  "peerDependencies": {
    "eve": ">=0.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eve": "^0.12.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "zod": "^4.4.0"
  }
}
